# Copy to .env for local Docker Compose. Do not commit .env.
# The Angular app does not read this file. Public build settings live in
# src/environments/environment.ts and environment.prod.ts.
# Secrets (database passwords, deploy tokens) never go in src/environments.

# Host port for ng serve.
WEB_PORT=4200

# Optional shared mark-book database:
#   docker compose --profile markbook up
POSTGRES_USER=exam
POSTGRES_PASSWORD=exam
POSTGRES_DB=exam_validator
POSTGRES_PORT=5432

# HTTP API in backend/. The Angular app does not read these.
# JWT_SECRET must be at least 32 characters. Replace the sample before sharing a server.
JWT_SECRET=replace-with-a-random-32-character-secret
DATABASE_URL=postgres://exam:exam@127.0.0.1:5432/exam_validator
API_PORT=8080
